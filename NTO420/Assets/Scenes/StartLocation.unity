    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435\n\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u044B\u0439
    \u0444\u0438\u043B\u044C\u0442\u0440 - 15\n\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B -5 \n\u0435\u0434\u0438\u043D\u0438\u0446
    \u043C\u0435\u0434\u043E\u0432\u043E\u0439 \u044D\u0441\u0441\u0435\u043D\u0446\u0438\u0438"
